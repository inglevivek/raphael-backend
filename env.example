# ========================================
# DOCKER ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and update with your values
# $ cp .env.example .env

# ========================================
# FLASK CONFIGURATION
# ========================================
FLASK_APP=run.py
FLASK_ENV=development
# Use 'production' for Railway deployment

# ========================================
# POSTGRESQL (Docker Container)
# ========================================
POSTGRES_DB=raphael_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Database URL (auto-constructed in docker-compose)
# Local access: postgresql://postgres:postgres@localhost:5432/raphael_dev
# Container access: postgresql://postgres:postgres@postgres:5432/raphael_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raphael_dev

# ========================================
# REDIS (Docker Container)
# ========================================
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# Redis URL (auto-constructed in docker-compose)
# Local access: redis://:redis_password@localhost:6379/0
# Container access: redis://:redis_password@redis:6379/0
REDIS_URL=redis://:redis_password@localhost:6379/0

# ========================================
# APPLICATION PORT
# ========================================
APP_PORT=5000

# ========================================
# API KEYS (Required)
# ========================================
# Get your Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your YouTube API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Generate a secure random key for JWT
# Use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# ========================================
# LLM CONFIGURATION
# ========================================
GROQ_MODEL=groq/compound-mini
# Other options: groq/llama-3.1-70b, groq/mixtral-8x7b

# ========================================
# RAILWAY DEPLOYMENT (Production)
# ========================================
# Railway auto-provides these when you add databases:
# DATABASE_URL=postgresql://...  (from Railway PostgreSQL)
# REDIS_URL=redis://...          (from Railway Redis)
# RAILWAY_ENVIRONMENT=production

# You only need to set in Railway Dashboard:
# - GROQ_API_KEY
# - YOUTUBE_API_KEY
# - JWT_SECRET_KEY
# - GROQ_MODEL (optional)
